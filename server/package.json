{
  "name": "@clipai/server",
  "version": "0.0.0",
  "private": true,
  "description": "Internal Alpha backend foundation.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "lint": "eslint src tests prisma.config.ts vitest.config.ts vitest.integration.config.ts --max-warnings=0",
    "test": "npm run prisma:generate && vitest run",
    "test:integration": "npm run prisma:generate && vitest run --config vitest.integration.config.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "express": "5.2.1",
    "jose": "6.2.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.15.3",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}

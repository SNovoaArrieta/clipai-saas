generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  personal
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  authSubject String     @unique @db.Uuid
  email       String?    @db.VarChar(254)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  workspace   Workspace?
}

model Workspace {
  id            String        @id @default(uuid()) @db.Uuid
  ownerUserId   String        @unique @db.Uuid
  name          String        @default("Personal workspace") @db.VarChar(120)
  workspaceType WorkspaceType @default(personal)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  owner         User          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

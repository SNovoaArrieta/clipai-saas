generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  personal
}

enum ProjectState {
  draft
  active
  archived
}

enum SourceType {
  upload
}

enum SourceState {
  submitted
  validating
  accepted
  rejected
}

enum AuthorizationBasis {
  owner
  authorized_by_owner
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  authSubject           String                 @unique @db.Uuid
  email                 String?                @db.VarChar(254)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  workspace             Workspace?
  ownershipAttestations OwnershipAttestation[]
}

model Workspace {
  id                    String                 @id @default(uuid()) @db.Uuid
  ownerUserId           String                 @unique @db.Uuid
  name                  String                 @default("Personal workspace") @db.VarChar(120)
  workspaceType         WorkspaceType          @default(personal)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  owner                 User                   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projects              Project[]
  ownershipAttestations OwnershipAttestation[]

  @@unique([id, ownerUserId])
}

model Project {
  id                   String       @id @default(uuid()) @db.Uuid
  workspaceId          String       @db.Uuid
  title                String       @db.VarChar(160)
  state                ProjectState @default(draft)
  createIdempotencyKey String       @db.VarChar(255)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt           DateTime?    @db.Timestamptz(3)
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sources              Source[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, createIdempotencyKey])
  @@index([workspaceId, updatedAt(sort: Desc), id(sort: Desc)])
}

model Source {
  id                    String                 @id @default(uuid()) @db.Uuid
  workspaceId           String                 @db.Uuid
  projectId             String                 @db.Uuid
  sourceType            SourceType             @default(upload)
  state                 SourceState            @default(submitted)
  safeReference         String                 @db.VarChar(255)
  durationMs            BigInt?
  isActive              Boolean                @default(false)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?              @db.Timestamptz(3)
  project               Project                @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Cascade)
  uploadIntent          UploadIntent?
  ownershipAttestations OwnershipAttestation[]

  @@unique([id, workspaceId, projectId])
  @@index([workspaceId, projectId])
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
}

model OwnershipAttestation {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @db.Uuid
  projectId            String             @db.Uuid
  sourceId             String             @db.Uuid
  userId               String             @db.Uuid
  statementVersion     String             @db.VarChar(32)
  authorizationBasis   AuthorizationBasis
  attestedAt           DateTime           @default(now()) @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  createIdempotencyKey String             @db.VarChar(255)
  source               Source             @relation(fields: [sourceId, workspaceId, projectId], references: [id, workspaceId, projectId], onDelete: Restrict, onUpdate: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workspace            Workspace          @relation(fields: [workspaceId, userId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workspaceId, createIdempotencyKey])
  @@unique([sourceId, statementVersion])
}

model UploadIntent {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @db.Uuid
  projectId            String    @db.Uuid
  sourceId             String    @unique @db.Uuid
  objectKey            String    @unique @db.VarChar(255)
  declaredContentType  String    @db.VarChar(100)
  declaredSizeBytes    BigInt
  originalFilename     String    @db.VarChar(255)
  expiresAt            DateTime  @db.Timestamptz(3)
  observedSizeBytes    BigInt?
  observedContentType  String?   @db.VarChar(100)
  storageEtag          String?   @db.VarChar(255)
  storageRevision      String?   @db.VarChar(1024)
  completedAt          DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  createIdempotencyKey String    @db.VarChar(255)
  source               Source    @relation(fields: [sourceId, workspaceId, projectId], references: [id, workspaceId, projectId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sourceId, workspaceId, projectId])
  @@unique([workspaceId, projectId, createIdempotencyKey])
  @@index([workspaceId, projectId])
  @@index([expiresAt])
}
